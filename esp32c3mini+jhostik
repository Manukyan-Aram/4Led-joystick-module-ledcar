#include <Arduino.h>

// ESP32-C3 Super Mini-ի համար ADC1 պիներ
const int pot1 = 0;  // x - GPIO0 (ADC1_CH0)
const int pot2 = 1;  // y - GPIO1 (ADC1_CH1)

void setup() {
  Serial.begin(115200);
  
  // Սպասում ենք Serial կապի ակտիվացմանը (հատկապես ESP32-C3 USB-CDC-ի համար)
  delay(1000);
  Serial.println("Պոտենցիոմետրերի ընթերցումը սկսված է...");
}

void loop() {
  int x = analogRead(pot1);
  int y = analogRead(pot2);

  // Արժեքների տպում Serial Monitor-ում
  Serial.print("X (pot1 - GPIO0): ");
  Serial.print(x);
  Serial.print("\t | \t Y (pot2 - GPIO1): ");
  Serial.println(y);

  delay(200); // Ընթերցումը 200մվ ընդմիջումով՝ հարմար դիտելու համար
}
