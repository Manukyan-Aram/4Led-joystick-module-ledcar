#include <esp_now.h>
#include <WiFi.h>

// Ստացող սարքի (Receiver) MAC հասցեն
uint8_t broadcastAddress[] = { 0x40, 0x91, 0x51, 0x7C, 0x1A, 0x8A };

// ESP32-C3 Super Mini-ի համար օգտագործում ենք ADC պիներ (GPIO 0 և GPIO 1)
const int pot1 = 0;  // X առանցք
const int pot2 = 1;  // Y առանցք

typedef struct struct_message {
  bool l1, l2, l3, l4, l5, l6, l7, l8, l9;
} struct_message;

struct_message myData;
struct_message lastData; 
esp_now_peer_info_t peerInfo;

void setup() {
  Serial.begin(115200);

  // ESP32-C3-ում ADC-ն ճիշտ աշխատեցնելու համար (0-ից ~3.3Վ տիրույթում)
  analogSetAttenuation(ADC_11db);

  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW initialization failed");
    return;
  }

  memcpy(peerInfo.peer_addr, broadcastAddress, 6);
  peerInfo.channel = 0; // 0 նշանակում է ընթացիկ ալիք
  peerInfo.encrypt = false;
  
  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("Failed to add peer");
    return;
  }
}

void loop() {
  int x = analogRead(pot1);
  int y = analogRead(pot2);

  // Ամեն ինչ սկզբից զրոյացնում ենք
  myData.l1 = myData.l2 = myData.l3 = myData.l4 = myData.l5 = myData.l6 = myData.l7 = myData.l8 = myData.l9 = false;

  // ESP32-C3-ի ADC-ն 12-բիտանոց է (0 - 4095 արժեքներ)
  // Շեմային արժեքները թողնված են նույնը (1500 և 2500)
  bool xLow  = (x < 1500);
  bool xHigh = (x > 2500);
  bool xMid  = (x >= 1500 && x <= 2500);

  bool yLow  = (y < 1500);
  bool yHigh = (y > 2500);
  bool yMid  = (y >= 1500 && y <= 2500);

  if (yHigh && xMid) {
    myData.l1 = true; // Առաջ (Forward)
  } 
  else if (yLow && xMid) {
    myData.l2 = true; // Ետ (Backward)
  } 
  else if (xHigh && yMid) {
    myData.l3 = true; // Աջ (Right)
  } 
  else if (xLow && yMid) {
    myData.l4 = true; // Ձախ (Left)
  } 
  else if (xHigh && yHigh) {
    myData.l5 = true; // Առաջ-Աջ (Diagonal)
  } 
  else if (xLow && yHigh) {
    myData.l6 = true; // Առաջ-Ձախ (Diagonal)
  } 
  else if (xHigh && yLow) {
    myData.l7 = true; // Ետ-Աջ (Diagonal)
  } 
  else if (xLow && yLow) {
    myData.l8 = true; // Ետ-Ձախ (Diagonal)
  } 
  else if (xMid && yMid) {
    myData.l9 = true; // Մեջտեղ / Հանգիստ վիճակ (Center)
  }

  // Ուղարկել միայն եթե տվյալը փոխվել է
  if (memcmp(&myData, &lastData, sizeof(myData)) != 0) {
    esp_now_send(broadcastAddress, (uint8_t *)&myData, sizeof(myData));
    memcpy(&lastData, &myData, sizeof(myData)); // Թարմացնում ենք վերջին վիճակը
  }

  delay(50); 
}
